#include "keys_de.h"
#include "zmk-helpers/helper.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        top_layer {
            bindings = <&mo 3>;
            key-positions = <37 40>;
            layers = <3>;
        };

        ae {
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <3 16>;
        };

        oe {
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <3 17>;
        };

        ue {
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <3 2>;
        };

        sz {
            bindings = <&kp DE_ESZETT>;
            key-positions = <3 22>;
        };
    };

    macros {
        ae: ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp DE_A &gresc &kp BACKSPACE &kp DE_A_UMLAUT>,
                <&macro_tap>;

            label = "AE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE        &kp DE_Q  &kp DE_W  &kp DE_E  &kp DE_R          &kp DE_T     &kp DE_Z   &kp DE_U       &kp DE_I      &kp DE_O       &kp DE_P         &kp BACKSPACE
&kp TAB           &kp DE_A  &kp DE_S  &kp DE_D  &kp DE_F          &kp DE_G     &kp DE_H   &kp DE_J       &kp DE_K      &kp DE_L       &kp DE_O_UMLAUT  &kp ENTER
&kp LEFT_CONTROL  &kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V          &kp DE_B     &kp DE_N   &kp DE_M       &kp DE_COMMA  &kp DE_PERIOD  &kp RIGHT_SHIFT  &kp RIGHT_ALT
                                      &mo 1     &kp LEFT_COMMAND  &kp SPACE    &kp SPACE  &kp BACKSPACE  &mo 2
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp LG(DE_Q)  &kp DE_EXCLAMATION  &kp UP_ARROW    &kp LG(DE_R)     &kp LG(DE_T)  &kp LG(DE_Z)    &kp BACKSPACE  &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_QUESTION  &kp C_VOLUME_UP
&kp LG(DE_A)  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RIGHT     &kp N5          &kp BACKSPACE  &kp DE_N4  &kp DE_N5  &kp DE_N6  &kp C_NEXT       &kp C_VOLUME_DOWN
&kp K_EJECT   &kp DE_MINUS        &kp DE_PLUS     &kp LG(DE_Z)     &kp LG(DE_V)  &kp UP_ARROW    &kp LG(DE_N)   &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp C_PREVIOUS   &kp DE_PLUS
                                                  &kp LGUI         &trans        &kp SPACE       &kp RET        &kp DE_N0  &mo 3
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp DE_SECTION    &kp DE_EXCLAMATION  &kp DE_DOUBLE_QUOTES  &kp UP_ARROW    &kp DE_PERCENT   &kp DE_AMPERSAND    &kp DE_SLASH  &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp C_VOL_DN    &kp UP_ARROW    &kp C_VOLUME_UP
&kp LCTRL         &kp DE_DOLLAR       &kp LEFT_ARROW        &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans              &kp INSERT    &kp UP_ARROW             &kp LEFT_ARROW            &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
&kp DE_LESS_THAN  &trans              &trans                &trans          &trans           &trans              &kp LEFT      &kp LEFT_ARROW           &kp MINUS                 &kp K_STOP      &kp K_PREV      &kp K_NEXT
                                                            &kp LGUI        &trans           &kp SPACE           &kp RET       &trans                   &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &trans          &kp UP_ARROW    &trans           &trans  &trans  &trans
&trans  &trans        &kp DE_N4     &kp DE_N5     &kp DE_N6     &trans               &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans
&trans  &trans        &kp DE_N1     &kp DE_N2     &kp DE_N3     &trans               &trans          &trans          &trans           &trans  &trans  &trans
                                    &trans        &trans        &kp LG(BACKSPACE)    &trans          &trans          &trans
            >;
        };

        layer_4 {
            bindings = <
&trans          &trans  &kp DE_U_UMLAUT  &trans  &trans           &trans             &trans  &trans  &trans  &trans  &trans         &trans
&trans          &trans  &trans           &trans  &kp DE_A_UMLAUT  &kp DE_O_UMLAUT    &trans  &trans  &trans  &trans  &kp DE_ESZETT  &trans
&kp LEFT_SHIFT  &trans  &trans           &trans  &trans           &trans             &trans  &trans  &trans  &trans  &trans         &trans
                                         &trans  &trans           &trans             &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
